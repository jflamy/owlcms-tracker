{
  "name": "owlcms-tracker",
  "version": "2.21.1",
  "private": true,
  "scripts": {
    "version:generate": "node scripts/generate-version.js",
    "predev": "node scripts/generate-version.js",
    "dev": "node node_modules/vite/bin/vite.js dev --port 8096",
    "predev:learning": "node scripts/generate-version.js",
    "dev:learning": "cross-env LEARNING_MODE=true node node_modules/vite/bin/vite.js dev --port 8096",
    "build:bundle": "svelte-kit sync && vite build && node scripts/copy-runtime-server-files.js",
    "build": "node scripts/generate-version.js && npm run build:bundle",
    "preview": "node start-with-ws.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "latest": "node scripts/get-latest-versions.js",
    "versions": "node scripts/get-latest-versions.js",
    "release": "node scripts/release.js",
    "zip": "node scripts/build-zip.js",
    "deploy:fly": "node scripts/deploy-fly.js",
    "clean": "node scripts/clean-plugin.js",
    "init": "node scripts/init-submodule.js",
    "deinit": "node scripts/deinit-submodule.js",
    "relink": "npm --prefix ../tracker-core link && npm link @owlcms/tracker-core"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.2.5",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.7.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "cross-env": "^7.0.3",
    "exceljs": "^4.4.0",
    "mustache": "^4.2.0",
    "puppeteer-core": "^24.0.0",
    "semver": "^7.6.0",
    "svelte": "^5.1.9",
    "svelte-check": "^4.0.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^4.0.13"
  },
  "type": "module",
  "dependencies": {
    "@owlcms/tracker-core": "github:owlcms/tracker-core#1.16.6",
    "adm-zip": "^0.5.10",
    "gsap": "^3.13.0",
    "http-proxy-middleware": "^3.0.5",
    "json5": "^2.2.3",
    "obs-websocket-js": "^5.0.6",
    "pagedjs": "0.4.3",
    "ws": "^8.18.3"
  }
}
