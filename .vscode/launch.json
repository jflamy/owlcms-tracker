{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🔳 tracker normal",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "NODE_ENV": "development",
        //"OWLCMS_UPDATEKEY": "amalauxpattes"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "🔳 tracker learning",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:learning"],
      "env": {
        "NODE_ENV": "development",
        "LEARNING_MODE": "true",
        //"OWLCMS_UPDATEKEY": "amalauxpattes"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}